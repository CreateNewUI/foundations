{
  "name": "@new-ui/effects",
  "version": "3.0.0",
  "description": "Layering, elevations, and effects styles",
  "source": "src/index.scss",
  "main": "dist/index.css",
  "css": "dist/index.css",
  "minified": "dist/index.min.css",
  "style": "./dist/index.css",
  "sass": "./src/index.scss",
  "exports": {
    ".": {
      "sass": "./src/index.scss",
      "style": "./dist/index.css",
      "default": "./dist/index.css"
    },
    "./css": "./dist/index.css",
    "./css/min": "./dist/index.min.css",
    "./scss": "./src/index.scss",
    "./package.json": "./package.json"
  },
  "targets": {
    "main": false,
    "css": {
      "optimize": false
    },
    "minified": {
      "optimize": true
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "watch": "PARCEL_WORKERS=0 parcel watch",
    "build": "PARCEL_WORKERS=0 parcel build",
    "prepublishOnly": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CreateNewUI/foundations.git"
  },
  "author": "@planetabhi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CreateNewUI/foundations/issues"
  },
  "homepage": "https://github.com/CreateNewUI/foundations#readme",
  "peerDependencies": {
    "@new-ui/colors": "^3.0.0"
  }
}
